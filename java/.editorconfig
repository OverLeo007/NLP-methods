root = true

[*.java]
charset = utf-8
indent_style = space
indent_size = 4
continuation_indent_size = 8
max_line_length = 120
insert_final_newline = true
trim_trailing_whitespace = true

[*.{gradle,xml,toml,properties}]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true

[*.cmd]
charset = utf-8
end_of_line = crlf
